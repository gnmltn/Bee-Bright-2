# Bee Bright Backend - Environment Variables

# Server
NODE_ENV=development
PORT=5001

# Client (for CORS and emails)
CLIENT_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# MongoDB (MUST start with mongodb:// or mongodb+srv://)
# Local MongoDB:
MONGODB_URI=mongodb+srv://gaealatina_db:4jZjGCmt@cluster0.leqpryo.mongodb.net/?appName=Cluster0

# URI
# MONGODB_URI=mongodb+srv://gaealatina_db:4jZjGCmt@cluster0.leqpryo.mongodb.net/?appName=Cluster0


MONGODB_TLS_CA_FILE=
MONGODB_TLS_ALLOW_INVALID_CERTS=false
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000


# JWT
JWT_SECRET=9f8c2a1b4e6d7c8a9f0e1d2c3b4a59687766554433221100ffeeddccbbaa9988
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_IN=30d
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

#BLOCH CHAIN
# Optional: encryption key for sensitive fields (32-byte hex = 64 chars)
ENCRYPTION_KEY=12345678901234567890123456789012
# Blockchain (Ganache + MetaMask) – Step 4: paste contract address from Remix after deploying BeeBrightPayments.sol
BEEBRIGHT_PAYMENTS_CONTRACT=0xD7ACd2a9FD159E69Bb102A1ca21C9a3e3A5F771B
# Ganache network in MetaMask: use 1337 (or 5777 if Ganache UI shows Network ID 5777)
GANACHE_CHAIN_ID=1337
# Optional: PHP per 1 ETH (default 250000 = 4750 PHP -> 0.019 ETH)
PHP_PER_ETH=250000

#AI
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi
OLLAMA_ENABLED=true

# Super admin seed (created automatically on server startup)
SUPER_ADMIN_EMAIL=gracefransoriano@gmail.com
SUPER_ADMIN_PASSWORD=Admin@123
SUPER_ADMIN_PHONE=+639123456789

# Backup / recovery
DB_BACKUP_DIR=.\backups
DB_BACKUP_RETENTION_DAYS=14

# Email / SMTP (required for OTP/password reset emails)
# Use a Google App Password (not your normal Gmail password) for SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=gaealatina@gmail.com
SMTP_PASS=kygvilzwgcrdvlqq
