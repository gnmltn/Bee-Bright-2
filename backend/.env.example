# Bee Bright Backend - Environment Variables

# Server
NODE_ENV=development
PORT=5000

# Client (for CORS and emails)
CLIENT_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# MongoDB (MUST start with mongodb:// or mongodb+srv://)
# Local MongoDB:
MONGODB_URI=mongodb://localhost:27017/beebright
# If using MongoDB Atlas, replace the line above with your Atlas URI, for example:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/beebright?retryWrites=true&w=majority
MONGODB_TLS_CA_FILE=
MONGODB_TLS_ALLOW_INVALID_CERTS=false
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
JWT_COOKIE_EXPIRES_IN=30d
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=



#BLOCH CHAIN
# Optional: encryption key for sensitive fields (32-byte hex = 64 chars)
ENCRYPTION_KEY=replace-with-a-32-byte-secret
# Blockchain (Ganache + MetaMask) – Step 4: paste contract address from Remix after deploying BeeBrightPayments.sol
BEEBRIGHT_PAYMENTS_CONTRACT=0x763a7f13c71cd4dBA4C8D3FfD905bd9395f3FfBf
# Ganache network in MetaMask: use 1337 (or 5777 if Ganache UI shows Network ID 5777)
GANACHE_CHAIN_ID=1337
# Optional: PHP per 1 ETH (default 250000 = 4750 PHP -> 0.019 ETH)
PHP_PER_ETH=250000

#AI
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi:latest
OLLAMA_ENABLED=true
# Per-request timeout for the phi fallback call. Cold start is ~60-70s, warm is ~2-5s.
# With the boot warm-up + keep_alive below, a short timeout is fine: a rare cold miss
# falls back to the canned reply quickly instead of making the user wait a minute.
OLLAMA_TIMEOUT_MS=20000
# How long Ollama keeps phi in memory after a request (avoids cold starts between calls).
OLLAMA_KEEP_ALIVE=10m
# Pre-warm phi when the server boots (Task 29b). Set to 0/false to disable.
OLLAMA_WARMUP=true
# Diagnostic only (Task 29c): log the exact Ollama request payload + raw pre-sanitize
# response to the console for llm / llm-fallback paths. Verbose — leave off normally.
OLLAMA_DEBUG=false
# Homework-help / tutoring companion (Task 5). OFF until the model question (Task 8)
# is settled — while false, tutoring-intent messages get a "not available yet" reply.
TUTORING_ENABLED=false
# Tutor-facing AI generation (Task 7 lesson prep). OFF; the tutor student-notes digest
# is deterministic and works regardless of this flag.
TUTOR_AI_ENABLED=false

# Super admin seed (used only to create the first super admin if missing)
# After creation, the super admin can change the password in Settings.
SUPER_ADMIN_EMAIL=superadmin@beebright.edu.ph
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
SUPER_ADMIN_PHONE=+639001112222

# Backup / recovery
DB_BACKUP_DIR=.\backups
DB_BACKUP_RETENTION_DAYS=14

# Email / SMTP (required for OTP/password reset emails)
# Use a Google App Password (not your normal Gmail password) for SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
